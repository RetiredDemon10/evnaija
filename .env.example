# ---------------------------------------------------------------------------
# EV Naija frontend
# Copy to .env.local and fill with values from your Supabase project.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_APP_URL="http://localhost:5173"

# Final public HTTPS origin used for canonical URLs, Open Graph and structured
# data. Set this to your real domain before deployment; preview/local origins
# must never become canonical URLs.
VITE_SITE_URL="https://evnaija.ng"

# Paystack public key (pk_test_... in test mode). The secret key belongs only
# in Supabase Edge Function secrets, never in this file or the browser.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional premium MapLibre style. Without these, the app uses OpenStreetMap
# raster tiles and still requires no token.
VITE_MAPS_STYLE_URL=""
VITE_MAPS_API_KEY=""

# Force the clearly-labelled preview dataset even when Supabase is configured.
# Never enable this in production.
VITE_DEMO_MODE="false"

# ---------------------------------------------------------------------------
# Legal identity — REQUIRED before production deployment.
# Use the exact registered entity name and CAC RC number from your certificate.
# `npm run legal:check` warns when these are missing or still placeholders.
# ---------------------------------------------------------------------------
VITE_LEGAL_ENTITY_NAME="Your Registered Entity Ltd"
VITE_LEGAL_RC_NUMBER="RC 000000"
VITE_LEGAL_TIN="00000000"
VITE_LEGAL_DPO_EMAIL="dpo@evnaija.ng"
