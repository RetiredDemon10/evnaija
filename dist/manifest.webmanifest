{
  "id": "/",
  "name": "EV Naija — Charge Without Limits",
  "short_name": "EV Naija",
  "description": "Find verified EV charging stations, reserve a charger and manage your charging sessions across Nigeria.",
  "lang": "en-NG",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F2FBF5",
  "theme_color": "#071B22",
  "categories": ["travel", "utilities", "navigation"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Find a charger",
      "short_name": "Find charger",
      "description": "Browse and reserve EV charging stations.",
      "url": "/app/stations",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My bookings",
      "short_name": "Bookings",
      "description": "Manage bookings, recurring plans and waitlists.",
      "url": "/app/bookings",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Support",
      "short_name": "Support",
      "description": "Open the EV Naija support centre.",
      "url": "/app/support",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
